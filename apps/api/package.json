{
  "name": "@stone-plan-ai/api",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "npm run prisma:generate && nest build",
    "prestart": "npm run prisma:generate",
    "start": "nest start",
    "prestart:dev": "npm run prisma:generate",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "pretest": "npm run prisma:generate",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:status": "prisma migrate status"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.2.3",
    "prisma": "7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.14",
    "typescript": "~6.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testRegex": "test/.*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/generated/**",
      "!src/main.ts"
    ]
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "mysql2": "3.24.6"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.10.0": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true
  }
}
