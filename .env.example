# Local Docker Compose demo. Copy to .env and choose your local password.
POSTGRES_DB=stoneplan
POSTGRES_USER=stoneplan
POSTGRES_PASSWORD=replace-with-local-demo-password
WEB_PORT=33050

# Optional existing PostgreSQL volume to reuse after a project rename.
POSTGRES_VOLUME_NAME=

# Explicit backend provider selection; no automatic fallback.
AI_PROVIDER=ollama

# Host-installed Ollama; URL as resolved by the NestJS Docker container.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=replace-with-your-installed-model-name
OLLAMA_TIMEOUT_MS=60000

# Optional hosted provider. Set AI_PROVIDER=openrouter to opt in (usage may cost money).
# Choose a model/provider endpoint supporting strict JSON Schema structured outputs.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_MS=60000
# Output budget including reasoning on most providers; integer 256-8192.
OPENROUTER_MAX_TOKENS=4096

# Compose constructs DATABASE_URL with host `db:5432`.
# An API started directly on the host needs its own localhost DATABASE_URL.
# OpenRouter credentials are not required in default Ollama mode.
